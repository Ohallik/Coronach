    },
    {
      "name": "repair and save restored party",
      "seconds": 0.3,
      "expectedScene": "Sorrel_Ridges",
      "buttons": [
        "South"
      ]
    },
    {
      "name": "release and inspect recovery",
      "seconds": 2,
      "expectedScene": "Sorrel_Ridges",

      "pauseUi": "defeat"
    },
    {
      "name": "stand undefended: wander undefended up the east branch",
      "seconds": 20,
      "stopWhen": "ui:defeat",
      "expectedScene": "Sorrel_Ridges",
      "pauseUi": "defeat"
    },
    {
      "name": "into the second scrapmite wash (the companion now fights back with skills, D201)",
      "seconds": 14,
      "navigate": true,
      "point": {
        "x": 36,
        "y": 0,
        "z": 73
      },
      "stopWhen": "ui:defeat",
      "expectedScene": "Sorrel_Ridges",
      "pauseUi": "defeat"
    },
    {
      "name": "stand undefended: into the second scrapmite wash",
      "seconds": 20,
      "stopWhen": "ui:defeat",
      "expectedScene": "Sorrel_Ridges",
      "pauseUi": "defeat"
    },
    {
      "name": "take the consequences without defence",
      "seconds": 90,
      "expectedScene": "Sorrel_Ridges",
      "until": "ui:defeat",
      "expectedUi": "defeat",
      "pauseUi": "defeat"
    },
    {
      "name": "inspect defeat choice",
      "seconds": 2,
      "expectedScene": "Sorrel_Ridges",
      "expectedUi": "defeat",
      "pauseUi": "defeat"
    },
    {
      "name": "retry last ordinary autosave",
      "seconds": 4,
      "expectedScene": "Sorrel_Ridges",
      "buttons": [
        "South"
      ],
      "expectedUi": "world",
      "pauseUi": "defeat",

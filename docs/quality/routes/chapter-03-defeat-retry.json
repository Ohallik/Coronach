      "x": 0.682,
      "y": 0.732,
      "stopWhen": "ui:defeat",
      "pauseUi": "defeat"
    },
    {
      "name": "wander undefended up the east branch (the companion now fights back with skills, D201)",
      "seconds": 14,
      "navigate": true,
      "point": {
        "x": 33,
        "y": 0,
        "z": 60
      },
      "stopWhen": "ui:defeat",
